model Branch {
  id             String   @id @default(cuid())
  organizationId String
  branchCode     String   @unique
  branchName     String
  branchTypeId   String
  managerId      String?
  divisionId     String?
  districtId     String?
  upazilaId      String?
  unionId        String?
  address        String?  @db.Text
  phone          String?
  email          String?
  latitude       Float?
  longitude      Float?
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchType     BranchType   @relation(fields: [branchTypeId], references: [id])
  manager        User?        @relation("BranchManagerUser", fields: [managerId], references: [id])
  division       Division?    @relation(fields: [divisionId], references: [id])
  district       District?    @relation(fields: [districtId], references: [id])
  upazila        Upazila?     @relation(fields: [upazilaId], references: [id])
  union          Union?       @relation(fields: [unionId], references: [id])

  branchSetting         BranchSetting?
  branchManagers        BranchManager[]
  branchStaffs          BranchStaff[]
  areaCoverages         AreaCoverage[]
  branchCoverages       BranchCoverage[]
  targets               BranchTarget[]
  performances          BranchPerformance[]
  budgets               BranchBudget[]
  funds                 BranchFund[]
  inventories           BranchInventory[]
  vehicles              BranchVehicle[]
  meetings              BranchMeeting[]
  announcements         BranchAnnouncement[]
  documents             BranchDocument[]
  audits                BranchAudit[]
  transfersFrom         BranchTransfer[]       @relation("TransferFromBranch")
  transfersTo           BranchTransfer[]       @relation("TransferToBranch")
  statistics            BranchStatistics[]
  dashboards            BranchDashboard[]
  activityLogs          BranchActivityLog[]
  parentHierarchies     OrganizationHierarchy[] @relation("ParentBranch")
  childHierarchies      OrganizationHierarchy[] @relation("ChildBranch")
  territoryAssignments  TerritoryAssignment[]
  zoneAssignments       ZoneAssignment[]

  @@map("branch")
}

model BranchType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches    Branch[]

  @@map("branch_type")
}

model BranchSetting {
  id            String   @id @default(cuid())
  branchId      String   @unique
  currency      String   @default("BDT")
  timezone      String   @default("Asia/Dhaka")
  workingHours  String?
  holidayPolicy String?  @db.Text
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_setting")
}

model BranchManager {
  id          String    @id @default(cuid())
  branchId    String
  userId      String
  designation String?
  joiningDate DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user        User      @relation("BranchManagerHistory", fields: [userId], references: [id], onDelete: Cascade)

  @@map("branch_manager")
}

model BranchStaff {
  id          String    @id @default(cuid())
  branchId    String
  userId      String
  role        String
  department  String?
  joiningDate DateTime?
  status      String    @default("ACTIVE")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user        User      @relation("BranchStaffHistory", fields: [userId], references: [id], onDelete: Cascade)
  staffRoles  StaffRole[]

  @@map("branch_staff")
}

model BranchTarget {
  id              String   @id @default(cuid())
  branchId        String
  year            Int
  targetMembers   Int      @default(0)
  targetDonation  Float    @default(0)
  targetProjects  Int      @default(0)
  targetCampaigns Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_target")
}

model BranchPerformance {
  id                String   @id @default(cuid())
  branchId          String
  year              Int
  achievementScore  Float    @default(0)
  completedProjects Int      @default(0)
  activeMembers     Int      @default(0)
  totalDonation     Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  branch            Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_performance")
}

model BranchBudget {
  id              String          @id @default(cuid())
  branchId        String
  fiscalYear      String
  allocatedBudget Float           @default(0)
  usedBudget      Float           @default(0)
  remainingBudget Float           @default(0)
  status          String          @default("ACTIVE")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  expenses        BranchExpense[]

  @@map("branch_budget")
}

model BranchExpense {
  id              String       @id @default(cuid())
  branchBudgetId  String
  expenseCategory String
  amount          Float
  description     String?      @db.Text
  approvedBy      String?
  expenseDate     DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  budget          BranchBudget @relation(fields: [branchBudgetId], references: [id], onDelete: Cascade)
  approver        User?        @relation("BranchExpenseApprover", fields: [approvedBy], references: [id])

  @@map("branch_expense")
}

model BranchFund {
  id             String   @id @default(cuid())
  branchId       String
  fundName       String
  currentBalance Float    @default(0)
  status         String   @default("ACTIVE")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_fund")
}

model BranchInventory {
  id        String   @id @default(cuid())
  branchId  String
  itemName  String
  quantity  Float    @default(0)
  unit      String?
  condition String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_inventory")
}

model BranchVehicle {
  id                 String   @id @default(cuid())
  branchId           String
  vehicleType        String
  registrationNumber String   @unique
  driverName         String?
  status             String   @default("ACTIVE")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  branch             Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_vehicle")
}

model BranchMeeting {
  id          String   @id @default(cuid())
  branchId    String
  title       String
  meetingDate DateTime
  location    String?
  agenda      String?  @db.Text
  minutes     String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_meeting")
}

model BranchAnnouncement {
  id          String   @id @default(cuid())
  branchId    String
  title       String
  description String   @db.Text
  publishedBy String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  publisher   User?    @relation("BranchAnnouncementPublisher", fields: [publishedBy], references: [id])

  @@map("branch_announcement")
}

model BranchDocument {
  id           String   @id @default(cuid())
  branchId     String
  documentType String?
  documentName String
  fileUrl      String
  uploadedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  uploader     User?    @relation("BranchDocumentUploader", fields: [uploadedBy], references: [id])

  @@map("branch_document")
}

model BranchAudit {
  id        String   @id @default(cuid())
  branchId  String
  auditYear String
  auditor   String
  remarks   String?  @db.Text
  status    String   @default("COMPLETED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_audit")
}

model BranchTransfer {
  id           String   @id @default(cuid())
  fromBranchId String
  toBranchId   String
  resourceType String
  referenceId  String?
  approvedBy   String?
  transferDate DateTime @default(now())
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromBranch   Branch   @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch     Branch   @relation("TransferToBranch", fields: [toBranchId], references: [id])
  approver     User?    @relation("BranchTransferApprover", fields: [approvedBy], references: [id])

  @@map("branch_transfer")
}

model BranchStatistics {
  id               String   @id @default(cuid())
  branchId         String
  memberCount      Int      @default(0)
  volunteerCount   Int      @default(0)
  campaignCount    Int      @default(0)
  projectCount     Int      @default(0)
  beneficiaryCount Int      @default(0)
  donationAmount   Float    @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branch           Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_statistics")
}

model BranchDashboard {
  id              String   @id @default(cuid())
  branchId        String
  dashboardConfig String?  @db.Text
  lastUpdated     DateTime @updatedAt
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_dashboard")
}

model BranchActivityLog {
  id          String   @id @default(cuid())
  branchId    String
  activity    String
  performedBy String?
  remarks     String?  @db.Text
  createdAt   DateTime @default(now())

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  performer   User?    @relation("BranchActivityPerformer", fields: [performedBy], references: [id])

  @@map("branch_activity_log")
}
